# Copy to .env and fill in:  cp .env.example .env && nano .env
# Keep .env private (chmod 600).

# Name shown in the server list / Friends tab
SERVER_NAME="Friends Server"

# World folder name (changing this later starts a NEW world)
LEVEL_NAME="friends-world"

# In-game operators. Left EMPTY: you host but don't play.
# Run any admin command from the VM instead:  ./mc cmd <command>
OPS=""

# Where backups go. A NAS share mounted here; if it isn't mounted, the scripts fall back to ./backups
BACKUP_DIR=/mnt/mc-backups
# Full nightly backups kept this many days
BACKUP_KEEP_DAYS=14
# Live snapshots (every 2 hours, no downtime) kept this many hours
SNAPSHOT_KEEP_HOURS=48
# In-game warning before the nightly full backup restarts the server (seconds, minimum 10)
BACKUP_WARNING=60
